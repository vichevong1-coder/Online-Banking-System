# Backend application-level config. Copy to `.env` (gitignored) to override.
# Root .env.example covers the docker-compose infra containers; this file is
# for the Spring Boot app itself.

# Matches docker-compose.yml defaults — override if you changed those.
DB_URL=jdbc:postgresql://localhost:5432/obs
DB_USERNAME=obs
DB_PASSWORD=obs

# Throwaway local-demo JWT signing key (US-004), not a secret. Override for
# anything beyond a local run.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_CHALLENGE_TOKEN_TTL=5m

# web-admin dev server origin, for CORS. Only needed if you run Vite on a
# non-default port.
WEB_ADMIN_ORIGIN=http://localhost:5173

# Bootstrap admin account (V2 migration), seeded so staff/admin login (US-010)
# has an account before the real admin-provisions-staff flow (US-047,
# Sprint 5) exists. Admin logs in with email; phone is still required for
# SMS-based 2FA (US-012). Password value below is bcrypt("ChangeMe123!") —
# a throwaway local-demo credential, not a secret. Override all three for
# anything beyond a local run.
ADMIN_BOOTSTRAP_PASSWORD_HASH=$2a$10$CPvFtm.yHrdrzSprtnnBueL/7ElKS8l65dN1LvRN1SXvgGiHxc/wy
ADMIN_BOOTSTRAP_EMAIL=admin@obs.local
ADMIN_BOOTSTRAP_PHONE=+855000000000
