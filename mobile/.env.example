# The Flutter app reads this at COMPILE time, not from this file — it is a
# --dart-define, so nothing loads .env at runtime (there is no dotenv package).
# This file documents the value and keeps CI's `cp .env.example .env` step happy.
#
#   Android emulator   http://10.0.2.2:8080   (the emulator's alias for the host)
#   iOS sim / desktop  http://localhost:8080
#   Physical phone     http://<your-machine-LAN-IP>:8080  e.g. http://192.168.1.20:8080
#
# Pass it when running or building:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.20:8080
API_BASE_URL=http://10.0.2.2:8080
