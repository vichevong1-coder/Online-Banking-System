# Root .env — consumed by docker-compose.yml only.
# Copy to `.env` (gitignored) if you want to override the defaults below.
# Each stack has its own .env for application-level config; this file is just
# the local infrastructure containers.
#
# These defaults match .github/workflows/backend-ci.yml so local and CI agree.
# They are throwaway local-demo credentials, not secrets.

DB_NAME=obs
DB_USERNAME=obs
DB_PASSWORD=obs

# Mailpit needs no configuration — SMTP on 1025, web inbox on http://localhost:8025.
